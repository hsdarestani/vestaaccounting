# BEGIN VESTA ACCOUNTING HTTPS ORIGIN
server {
    listen 80;
    server_name hesab.vesta-cosmetics.ir hesab-stage.vesta-cosmetics.ir;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name hesab.vesta-cosmetics.ir hesab-stage.vesta-cosmetics.ir;
    ssl_certificate /etc/nginx/certs/vesta-accounting/origin.pem;
    ssl_certificate_key /etc/nginx/certs/vesta-accounting/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/certs/vesta-accounting/edge-acl.conf;
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $accounting_proxy vesta-accounting-proxy-origin:8080;
    access_log off;
    proxy_http_version 1.1;
    proxy_set_header Host hesab.vesta-cosmetics.ir;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For "";
    client_max_body_size 2m;
    proxy_read_timeout 40s;
    location = /health {
        proxy_pass http://$accounting_proxy;
    }
    location / {
        if ($host = hesab-stage.vesta-cosmetics.ir) { return 404; }
        proxy_pass http://$accounting_proxy;
    }
}
# END VESTA ACCOUNTING HTTPS ORIGIN
